# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Django
DEBUG=True
# Required when DEBUG=False. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Optional data-provider key. Without it the news, IPO and monthly-trend parts are empty or use Yahoo.
# Finnhub (free tier) adds company/market news, the IPO calendar and monthly analyst trends.
FINNHUB_API_KEY=
# SEC EDGAR (free, no key) adds a company's 8-K filings to its news. SEC requires a User-Agent
# with your name and a contact email: SEC_USER_AGENT=Your Name you@example.com
SEC_USER_AGENT=

# Visitor counts (optional, free for personal sites, no cookies): create a site on goatcounter.com
# and put its code here, e.g. GOATCOUNTER_CODE=marketwatch for https://marketwatch.goatcounter.com
GOATCOUNTER_CODE=

# Headline sentiment: "lexicon" (default) or "finbert" (needs requirements-finbert.txt locally,
# or the image built with --build-arg SENTIMENT_MODEL=finbert). See docs/SENTIMENT_EVAL.md.
# The Docker image sets this itself (leave it unset here, or --env-file would override the image).
# Locally, fetch the word list first:  python scripts/fetch_sentiment_data.py lexicon
# SENTIMENT_MODEL=lexicon

# Optional: pre-fill the per-process cache after startup.
CACHE_WARMUP=0
CACHE_WARMUP_URL=http://127.0.0.1:8000
